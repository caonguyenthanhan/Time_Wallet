<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Optional internet permission for Opt-in AI suggestion extraction only -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Local confirmation reminder notification when planned/ongoing end time arrives (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Re-register local completion reminder alarms after reboot or package replacement -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional direct APK installer permission for GitHub Releases update channel (omitted on Google Play channel) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Opt-in floating mascot assistant across other apps (Settings.canDrawOverlays, never reads screen content) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".TimeWalletApp"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TimeWallet">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.TimeWallet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>

        <receiver
            android:name=".notifications.CompletionReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.CompletionBootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.WallyHomeWidgetProvider"
            android:exported="true"
            android:label="@string/wally_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.timewallet.mvp.widget.ACTION_REFRESH" />
                <action android:name="com.timewallet.mvp.widget.ACTION_PAUSE_RESUME" />
                <action android:name="com.timewallet.mvp.widget.ACTION_STOP_SAVE" />
                <action android:name="com.timewallet.mvp.widget.ACTION_TOGGLE_TODO" />
                <action android:name="com.timewallet.mvp.widget.ACTION_NEXT_TODO" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wally_home_widget_info" />
        </receiver>

        <service
            android:name=".widget.WallyHomeWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <service
            android:name=".overlay.WallyFloatingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Opt-in floating mascot time tracker and to-do companion" />
        </service>
    </application>

</manifest>

